{
  "name": "lecturemind-ai-windows",
  "version": "1.0.0",
  "description": "LectureMind AI Windows desktop application",
  "main": "main.js",
  "author": "LectureMind AI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "build:installer": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:dir": "electron-builder --win --dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.lecturemind.ai",
    "productName": "LectureMind AI",
    "artifactName": "LectureMind-AI-${version}-${arch}.${ext}",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "LectureMind_AI_app.html",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
  
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LectureMind AI",
      "deleteAppDataOnUninstall": false
    }
  },
  "engines": {
    "node": ">=20"
  }
}
